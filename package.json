{
  "name": "nlbb-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1 --clearScreen false",
    "dev:esbuild": "esbuild src/main.tsx --bundle --outdir=dev-dist/assets --entry-names=app --format=iife --platform=browser --target=es2017 --jsx=automatic --inject:src/react-shim.js --watch --servedir=dev-dist --serve=127.0.0.1:5180 --serve-fallback=dev-dist/index.html",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.1.0"
  }
}
